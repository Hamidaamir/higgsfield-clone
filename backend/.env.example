# --- Core ---
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
SESSION_SECRET=change-me-to-a-long-random-string
# Comma-separated list of allowed browser origins (only needed when the
# frontend calls the API directly instead of through the Next.js rewrite).
CORS_ORIGINS=http://localhost:3000

# --- Media storage (Cloudinary free tier) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Image + TTS (Cloudflare Workers AI free tier) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- TTS model #2 (Google AI Studio free tier) ---
GEMINI_API_KEY=

# --- Video (LTX-Video via a public Hugging Face ZeroGPU Space) ---
# Optional but recommended: a free-account read token lifts the daily ZeroGPU quota
# from 2 min (anonymous, per IP) to 5 min (per account). Create at huggingface.co/settings/tokens
HF_TOKEN=
# Dev/test only: 1 swaps real providers for in-process fakes (never set in production)
USE_FAKE_PROVIDERS=0
