# --- Core ---
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
SESSION_SECRET=change-me-to-a-long-random-string
# Allowed browser origins, only needed when something calls the API directly instead of
# through the Next.js rewrite. Comma-separated or a JSON array; both are accepted.
CORS_ORIGINS=http://localhost:3000

# Browser-facing origin of the Next app (OAuth redirect URIs are derived from it).
PUBLIC_APP_URL=http://localhost:3000

# --- Google sign-in (Google Cloud Console → OAuth client, type "Web application") ---
# Authorized redirect URI must be exactly: {PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Media storage (Cloudinary free tier) ---
# Root folder for new uploads. Unset keeps the environment-scoped default
# (higgsfield-clone/<APP_ENV>) so existing assets stay where they are; production sets
# this explicitly, e.g. forma/production.
CLOUDINARY_ROOT_FOLDER=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Image + TTS (Cloudflare Workers AI free tier) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- TTS model #2 (Google AI Studio free tier) ---
GEMINI_API_KEY=

# --- Video (LTX-Video via a public Hugging Face ZeroGPU Space) ---
# Optional but recommended: a free-account read token lifts the daily ZeroGPU quota
# from 2 min (anonymous, per IP) to 5 min (per account). Create at huggingface.co/settings/tokens
HF_TOKEN=
# Dev/test only: 1 swaps real providers for in-process fakes (never set in production)
USE_FAKE_PROVIDERS=0

# --- Tuning (safe defaults; override only if needed) ---
# Per-user cap on generation requests per minute (all types).
GENERATION_RATE_LIMIT_PER_MINUTE=12
# Video shares one tiny daily GPU quota across every user of the deployment.
VIDEO_RATE_LIMIT_PER_USER_10MIN=3
VIDEO_RATE_LIMIT_GLOBAL_PER_HOUR=6
# Fake-provider mode only: simulated provider latency in seconds.
FAKE_PROVIDER_LATENCY_S=2
